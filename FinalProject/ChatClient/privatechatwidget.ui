  <property name="styleSheet">
   <string notr="true">/* ================= 统一基础 ================= */
QWidget {
    background-color: #f5f7fa;
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 14px;
    color: #333333;
}

/* ================= 顶部标题（蓝渐变 + 白字） ================= */
QLabel#targetLabel {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    background-color: #409eff;   /* 纯色蓝底 */
    padding: 6px;
    border-radius: 8px;
}

/* ================= 聊天浏览区 ================= */
QTextEdit#chatBrowser {
    border: 1px solid #dcdfe6;
    border-radius: 8px;
    padding: 8px;
    background-color: #ffffff;
    font-size: 13px;
    color: #303133;
}

/* ================= 输入框（同高 32） ================= */
QLineEdit#msgEdit {
    height: 32px;
    padding: 0 8px;
    border-radius: 6px;
    border: 1px solid #dcdfe6;
    background-color: #ffffff;
}

QLineEdit#msgEdit:focus {
    border: 1px solid #409eff;
}

/* ================= 按钮（同高 32） ================= */
QPushButton {
    height: 32px;
    padding: 0 15px;
    border-radius: 6px;
    background-color: #409eff;
    color: #ffffff;
    border: none;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #66b1ff;
}

QPushButton:pressed {
    background-color: #337ecc;
}

/* ================= 关闭按钮（红底白字） ================= */
QPushButton#closeButton {
    background-color: #f56c6c;
    color: #ffffff;
}

QPushButton#closeButton:hover {
    background-color: #f78989;
}

/* ================= 细滚动条 ================= */
QScrollBar:vertical {
    width: 8px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #c0c4cc;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #909399;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0px;
}</string>
  </property>
