  <property name="styleSheet">
   <string notr="true">/* 全局基础样式 */
QWidget {
background-color: #f5f7fa;
font-family: &quot;Microsoft YaHei&quot;;
font-size: 14px;
color: #333333;
}

/* 标题栏 */
QLabel#titleLabel {
font-size: 18px;
font-weight: bold;
color: #2c3e50;
background: #409eff;
color: white;
padding: 6px;
border-radius: 8px;
}

QLabel#label_2{
 background: transparent;
    font-size: 14px;
}

QLabel#label_3 {
 background: transparent;
    font-size: 14px;
}

/* 输入框统一 */
QLineEdit {
height: 30px;
padding: 4px 8px;
border-radius: 5px;
border: 1px solid #dcdfe6;
background-color: #ffffff;
}

QLineEdit:focus {
border: 1px solid #409eff;
}

QFrame#loginFrame {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 16px;
    padding: 6px;
}

/* 按钮统一 */
/* ======= 输入框 / 按钮 同高 32 ======= */
QLineEdit {
    height: 32px;
    padding: 0 8px;
    border-radius: 6px;
    border: 1px solid #dcdfe6;
    background-color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #409eff;
}

QPushButton {
    height: 32px;
    padding: 0 15px;
    border-radius: 6px;
    background-color: #409eff;
    color: #ffffff;
    border: none;
}

QPushButton:hover {
    background-color: #66b1ff;
}

QPushButton:pressed {
    background-color: #337ecc;
}

/* 退出/返回公聊按钮 */
QPushButton#logoutButton,
QPushButton#backToPublicButton {
background-color: #f56c6c;
}

QPushButton#logoutButton:hover,
QPushButton#backToPublicButton:hover {
background-color: #f78989;
}

/* 聊天区 */
QTextEdit {
border: 1px solid #dcdfe6;
border-radius: 6px;
padding: 6px;
background-color: #ffffff;
}

/* 用户列表 */
QListView {
border: 1px solid #dcdfe6;
border-radius: 6px;
background-color: #ffffff;
}

QListView::item {
height: 28px;
padding-left: 6px;
}

QListView::item:selected {
background-color: #ecf5ff;
color: #409eff;
}

/* 滚动条美化 */
QScrollBar:vertical {
width: 8px;
background: transparent;
}

QScrollBar::handle:vertical {
background: #c0c4cc;
border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
background: #909399;
}

QScrollBar::add-line,
QScrollBar::sub-line {
height: 0px;
}
</string>
